# Polymarket Bot — Environment Variables
# Copy this file to .env and fill in your values.

# Your Polygon wallet private key (hex, without 0x prefix)
POLYMARKET_PRIVATE_KEY=

# Polymarket CLOB API Builder credentials
# Get these from: https://docs.polymarket.com
POLY_BUILDER_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=

# Your wallet address (EOA address, or Gnosis Safe address if using Safe mode)
WALLET_ADDRESS=

# Polygon RPC URL (Alchemy, Infura, or any Polygon RPC provider)
POLYGON_RPC_URL=https://polygon-rpc.com

# Optional: Telegram alerting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
