{
  "uid": "polymarket-bot",
  "title": "Polymarket Bot",
  "tags": ["polymarket", "trading"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "asset",
        "type": "custom",
        "label": "Asset",
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [
          { "text": "All", "value": "$__all", "selected": true },
          { "text": "BTC", "value": "BTC", "selected": false },
          { "text": "ETH", "value": "ETH", "selected": false },
          { "text": "SOL", "value": "SOL", "selected": false },
          { "text": "XRP", "value": "XRP", "selected": false }
        ],
        "query": "BTC,ETH,SOL,XRP"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Session PnL",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "session_pnl_usd{asset=~\"$asset\"}",
          "legendFormat": "{{asset}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Daily PnL",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0 },
              { "color": "green", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "daily_pnl_usd{asset=~\"$asset\"}",
          "legendFormat": "{{asset}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active Markets",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "active_markets{asset=~\"$asset\"}",
          "legendFormat": "{{asset}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Total Exposure",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "total_exposure_usd{asset=~\"$asset\"}",
          "legendFormat": "{{asset}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Period Performance",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false
    },
    {
      "type": "histogram",
      "title": "Period PnL Distribution",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(period_pnl_usd_sum{asset=~\"$asset\"}[5m])",
          "legendFormat": "{{asset}} sum",
          "refId": "A"
        },
        {
          "expr": "rate(period_pnl_usd_count{asset=~\"$asset\"}[5m])",
          "legendFormat": "{{asset}} count",
          "refId": "B"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Periods Won / Lost",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*win.*" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*loss.*" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "periods_completed_total{asset=~\"$asset\", result=\"win\"}",
          "legendFormat": "{{asset}} win",
          "refId": "A"
        },
        {
          "expr": "periods_completed_total{asset=~\"$asset\", result=\"loss\"}",
          "legendFormat": "{{asset}} loss",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Complete Pairs per Period",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(period_complete_pairs_sum{asset=~\"$asset\"}[5m])",
          "legendFormat": "{{asset}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Fills per Period",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(period_fills_total{asset=~\"$asset\"}[5m])",
          "legendFormat": "{{asset}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Trading Activity",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Orders Placed Rate",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(orders_placed_total{asset=~\"$asset\", type=\"buy\"}[1m])",
          "legendFormat": "{{asset}} buy",
          "refId": "A"
        },
        {
          "expr": "rate(orders_placed_total{asset=~\"$asset\", type=\"sell\"}[1m])",
          "legendFormat": "{{asset}} sell",
          "refId": "B"
        },
        {
          "expr": "rate(orders_placed_total{asset=~\"$asset\", type=\"buy_fok\"}[1m])",
          "legendFormat": "{{asset}} fok",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Fills Rate",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(fills_total{asset=~\"$asset\"}[1m])",
          "legendFormat": "{{asset}} {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tick Placed vs Skipped",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(tick_placed_total{asset=~\"$asset\"}[1m])",
          "legendFormat": "{{asset}} placed",
          "refId": "A"
        },
        {
          "expr": "rate(tick_skipped_total{asset=~\"$asset\"}[1m])",
          "legendFormat": "{{asset}} skipped",
          "refId": "B"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Suppression Reasons",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "xTickLabelRotation": -45,
        "stacking": "normal"
      },
      "targets": [
        {
          "expr": "increase(suppression_total{asset=~\"$asset\"}[5m])",
          "legendFormat": "{{reason}}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "reason": { "aggregations": [], "operation": "groupby" },
              "Value": { "aggregations": ["sum"], "operation": "aggregate" }
            }
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Market Quality",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Fill Edge (cents)",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "cents",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 3,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(fill_edge_cents_sum{asset=~\"$asset\"}[5m]) / rate(fill_edge_cents_count{asset=~\"$asset\"}[5m])",
          "legendFormat": "{{asset}} avg edge",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Order Latency (ms)",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(order_latency_ms_bucket{asset=~\"$asset\"}[5m]))",
          "legendFormat": "{{asset}} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(order_latency_ms_bucket{asset=~\"$asset\"}[5m]))",
          "legendFormat": "{{asset}} p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(order_latency_ms_bucket{asset=~\"$asset\"}[5m]))",
          "legendFormat": "{{asset}} p99",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Quote Cycle Duration (ms)",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(quote_cycle_duration_ms_bucket{asset=~\"$asset\"}[5m]))",
          "legendFormat": "{{asset}} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(quote_cycle_duration_ms_bucket{asset=~\"$asset\"}[5m]))",
          "legendFormat": "{{asset}} p95",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Asset Price",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "asset_price_usd{asset=~\"$asset\"}",
          "legendFormat": "{{asset}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Position & Risk",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Position Shares",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 37 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "position_yes_shares{asset=~\"$asset\"}",
          "legendFormat": "{{asset}} YES",
          "refId": "A"
        },
        {
          "expr": "position_no_shares{asset=~\"$asset\"}",
          "legendFormat": "{{asset}} NO",
          "refId": "B"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Complete Pairs",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 37 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "position_complete_pairs{asset=~\"$asset\"}",
          "legendFormat": "{{asset}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Budget Used",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 37 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "max": 50,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 45 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "budget_used_usd{asset=~\"$asset\"}",
          "legendFormat": "{{asset}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Sigma (Volatility)",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 37 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sigma_per_sec{asset=~\"$asset\"}",
          "legendFormat": "{{asset}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Health & Errors",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 45 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Rate Limit Hits",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 46 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "lineWidth": 1
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(rate_limit_hits_total{asset=~\"$asset\"}[1m])",
          "legendFormat": "{{asset}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "WS Orderbook Divergence",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 46 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(ws_orderbook_divergence_total{asset=~\"$asset\", severity=\"severe\"}[1m])",
          "legendFormat": "{{asset}} severe",
          "refId": "A"
        },
        {
          "expr": "rate(ws_orderbook_divergence_total{asset=~\"$asset\", severity=\"moderate\"}[1m])",
          "legendFormat": "{{asset}} moderate",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Price Feed Divergence",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 46 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(price_feed_divergence_total{asset=~\"$asset\"}[1m])",
          "legendFormat": "{{asset}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Merges",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 46 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(merges_total{asset=~\"$asset\"}[5m])",
          "legendFormat": "{{asset}}",
          "refId": "A"
        }
      ]
    }
  ]
}
